# Copy these into the Secrets box in Streamlit Community Cloud (App settings > Secrets).
# For local runs, copy this file to .streamlit/secrets.toml (never commit that file).
GOOGLE_API_KEY = "your-gemini-key"

# Optional: send telemetry to Dynatrace. Remove these lines to run without telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT = "https://YOUR_ENV_ID.live.dynatrace.com/api/v2/otlp"
OTEL_EXPORTER_OTLP_HEADERS = "Authorization=Api-Token YOUR_DT_TOKEN"
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE = "delta"
OTEL_SEMCONV_STABILITY_OPT_IN = "gen_ai_latest_experimental"

# Optional model settings (defaults shown)
# MODEL = "gemini-3.5-flash-lite"
# FALLBACK_MODEL = "gemini-3.8-flash"
# JUDGE_MODEL = "gemini-3.5-flash-lite"
